# Go Gin Application Port (Same as NestJS internally)
PORT=3000

# Database Configuration (HAProxy Endpoint)
DB_HOST=haproxy
DB_PORT_WRITE=5432
DB_PORT_READ=5433
DB_USERNAME=hydra_user
DB_PASSWORD=hydra_pwd
DB_DATABASE=hydra_db

# PostgreSQL Base Infrastructure Configuration
POSTGRES_DB=hydra_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_admin_pwd

# Database Replication Setup
REPLICATION_USER=replica_user
REPLICATION_PASSWORD=replica_pwd
